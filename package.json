{
  "name": "@charleypeng/dsh-model-tier-slider",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Select a model and its advertised reasoning effort from the session composer.",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test controller.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "license": "MIT",
  "author": "charleypeng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charleypeng/dsh-model-tier-slider.git"
  }
}
